<% notification = notifications_by_message_id[event.message_id] %>
<tr<% if notification %> class="clickable-row" role="link" tabindex="0" data-href="<%= notification_path(notification) %>"<% end %>>
  <td><span class="badge badge-<%= event.event_type %>"><%= event.event_type %></span></td>
  <td><%= truncate(event.recipient, length: recipient_length) %></td>
  <% if detailed %>
    <td><code><%= truncate(event.message_id, length: 20) %></code></td>
    <td>
      <% if event.options.present? %>
        <details onclick="event.stopPropagation()">
          <summary class="btn btn-secondary btn-sm">View</summary>
          <pre class="event-details"><%= format_event_options(event.options) %></pre>
        </details>
      <% else %>
        -
      <% end %>
    </td>
    <td><%= format_timestamp(event_timestamp(event)) %></td>
  <% else %>
    <td><%= event_timestamp(event).strftime('%b %d, %H:%M') %></td>
  <% end %>
</tr>
