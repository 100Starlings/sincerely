<div class="page-header">
  <div>
    <h1 class="page-title"><%= @template.name %></h1>
    <p class="page-subtitle"><%= @template.type.demodulize.underscore.humanize %></p>
  </div>
  <div class="header-actions">
    <a href="<%= sincerely.preview_template_path(@template) %>" class="btn btn-secondary" target="_blank">Preview</a>
    <a href="<%= sincerely.edit_template_path(@template) %>" class="btn btn-primary">Edit</a>
    <a href="<%= sincerely.templates_path %>" class="btn btn-secondary">Back to List</a>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Details</h2>
    </div>
    <div class="details-grid">
      <div class="detail-row">
        <span class="detail-label">Name</span>
        <span class="detail-value"><%= @template.name %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Type</span>
        <span class="detail-value"><span class="badge"><%= @template.type.demodulize.underscore.humanize %></span></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Subject</span>
        <span class="detail-value"><%= @template.subject %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Sender</span>
        <span class="detail-value"><%= @template.sender %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Created</span>
        <span class="detail-value"><%= @template.created_at.strftime('%b %d, %Y %H:%M') %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Updated</span>
        <span class="detail-value"><%= @template.updated_at.strftime('%b %d, %Y %H:%M') %></span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Usage Statistics</h2>
    </div>
    <div class="stats-mini">
      <div class="stat-mini">
        <div class="stat-mini-value"><%= @notification_count %></div>
        <div class="stat-mini-label">Notifications Sent</div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">HTML Content</h2>
  </div>
  <div class="code-block">
    <pre><%= @template.html_content %></pre>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Text Content</h2>
  </div>
  <div class="code-block">
    <pre><%= @template.text_content %></pre>
  </div>
</div>
